# Served by LiteSpeed/Apache from the app root. Hashed assets never change, so they may be cached forever; the
# worker and the shell must be re-checked so a new deploy is picked up.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|svg|pbf|pmtiles)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # The basemap is public data; letting other origins read it means a local preview build can run against the live copy.
  <If "%{REQUEST_URI} =~ m#/basemap/#">
    Header set Access-Control-Allow-Origin "*"
  </If>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
